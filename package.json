{
  "name": "rupesh-portfolio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:admin": "turbo run dev --filter=@repo/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "check-types": "turbo run check-types",
    "content:seed": "turbo run seed --filter=@repo/content",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.5",
  "engines": {
    "node": ">=20"
  }
}
